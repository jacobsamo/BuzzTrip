export interface IconProps {
  name: IconType;
  color?: React.CSSProperties["color"] | string;
  size?: number;
  weight?: "thin" | "light" | "regular" | "bold" | "fill" | "duotone";
}

/**
 * Icon component displaying Phosphor icons based on the icon name
 */
const Icon = ({
  name = "map-pin",
  color = "#000",
  size = 24,
  weight = "regular",
  ...props
}: IconProps) => {
  const DisplayIcon = Icons[name] || MapPin;

  return <DisplayIcon color={color} size={size} weight={weight} {...props} />;
};

export default Icon;

export const iconsList = Object.keys(Icons) as IconType[];
